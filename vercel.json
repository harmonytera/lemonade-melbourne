{
  "functions": {
    "api/tour-page.js": {
      "includeFiles": "*.html"
    }
  },
  "routes": [
    {
      "src": "/(index|consultation|aftercare|policies|pre-appointment)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/(index|consultation|aftercare|policies|pre-appointment)/?",
      "dest": "/api/tour-page?page=$1"
    },
    {
      "src": "/",
      "dest": "/api/tour-page?page=index"
    },
    {
      "handle": "filesystem"
    }
  ]
}
